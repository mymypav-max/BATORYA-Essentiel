+
+def prevu(total_cents, type_, valeur):
+    """Oracle : acompte prévu d'un devis, en centimes (HALF_UP, entiers purs)."""
+    if type_ == "aucun":
+        return 0
+    v = int(valeur.replace(".", ""))
+    if type_ == "montant":
+        return v
+    return (total_cents * v * 2 + 10000) // 20000                                                    # arrondi HALF_UP de total × pct / 100 sans flottant
