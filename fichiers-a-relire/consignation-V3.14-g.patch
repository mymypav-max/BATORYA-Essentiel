+def trigger_attendu():
+    """Définition du trigger telle que 009a la crée (sans commentaires ni « ; » final, espaces normalisés)."""
+    instr = [T.sans_commentaires(s).strip() for s in T.instructions(SQL_009A)]
+    return _norm(instr[0])
